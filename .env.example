# Copy to .env (or paste the keys into the app's Settings page instead). All are free.
# Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# setlist.fm (non-commercial use): https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
# Ticketmaster Discovery: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# Bandsintown app_id (issued by Bandsintown on request)
BANDSINTOWN_APP_ID=
# Optional Spotify Web API app (used to look up artist IDs; follower counts only if your app still receives them)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Your email, added to the User-Agent as MusicBrainz asks API clients to identify themselves
CONTACT_EMAIL=
# Comma-separated source names to turn off, e.g. instagram,tiktok
DISABLED_SOURCES=
# Where the database and custom weights live (default ./data)
# ARTISTSCORE_DATA_DIR=./data
